<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily incremental summary pass: picks up newly arrived threads and
     refreshes summaries whose thread got new messages. No-ops in seconds when
     nothing changed, and exits quietly if MishMail isn't running.
     Install:  launchctl load -w ~/Library/LaunchAgents/dev.ronboger.mishmail-summarize.plist
     Remove:   launchctl unload -w ~/Library/LaunchAgents/dev.ronboger.mishmail-summarize.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ronboger.mishmail-summarize</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ronboger/mishmail/scripts/mishmail-summarize-daily.sh</string>
    </array>
    <!-- Daily at 06:15. Edit the shell script, not this file, to change
         model/backend — including switching to a cloud model later. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>15</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/mishmail-summarize.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mishmail-summarize.err</string>
</dict>
</plist>
