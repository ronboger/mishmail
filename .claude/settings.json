{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-build-warnings-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking build output for warnings"
          }
        ]
      }
    ]
  }
}
